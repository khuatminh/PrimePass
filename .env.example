# Copy file này thành .env rồi điền giá trị thật; Spring tải .env ở thư mục gốc khi chạy local
# cp .env.example .env

# Database
DB_NAME=digital_marketplace
DB_USER=root
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# VNPay (thay bằng thông tin thật khi go-live)
VNPAY_TMN_CODE=CHANGE_ME_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=CHANGE_ME_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://example.com/payment/callback

# Optional one-time admin bootstrap
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
